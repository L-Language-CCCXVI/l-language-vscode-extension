{
  "name": "l-language-vscode-extension",
  "displayName": "L Language",
  "description": "Language support for the L language",
  "version": "2026.11.0",
  "publisher": "L-Language",
  "homepage": "https://l-lang.com",
  "repository": "https://github.com/L-Language-CCCXVI/l-language-vscode-extension",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "L Language",
    "real-time",
    "data analysis",
    "lean",
    "high-performant",
    "lucid"
  ],
  "icon": "images/icon.png",
  "extensionKind": ["workspace"],
  "activationEvents": [],
  "main": "./target/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "l",
        "aliases": ["L", "l"],
        "extensions": [".ll"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "l",
        "scopeName": "source.l",
        "path": "./syntaxes/l.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "L Language",
      "properties": {
        "l-language-vscode-extension.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the L language executable. Leave empty to use PATH."
        },
        "l-language-vscode-extension.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between L Language Client and Server."
        },
        "l-language-vscode-extension.includeDirectory": {
          "type": "string",
          "default": "",
          "description": "Root directory for including L files. Workspace directory is used if it is empty. The value must end with '/'"
        }
      }
    },
    "commands": [
      {
        "command": "l-language-vscode-extension.startServer",
        "title": "L: Start Language Server"
      },
      {
        "command": "l-language-vscode-extension.restartServer",
        "title": "L: Restart Language Server"
      }
    ],
    "iconThemes": [
      {
        "id": "l-language-icon-theme",
        "label": "L Language Icons",
        "path": "./fileicons/l-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/esbuild.js",
    "check-types": "tsc --noEmit -p ./",
    "watch": "tsc --watch -p ./",
    "vscode:prepublish": "npm run check-types && npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.75.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
