{
  "name": "l-language-vscode-extension",
  "displayName": "L Language",
  "description": "Syntax highlighting for the L Language (.ll files)",
  "version": "2026.9.0",
  "publisher": "L-Language",
  "homepage": "https://l-lang.com",
  "repository": "https://github.com/L-Language-CCCXVI/l-language-vscode-extension",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "L Language",
    "real-time",
    "data analysis",
    "lean",
    "high-performant",
    "lucid"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "L",
        "aliases": ["L"],
        "extensions": [".ll"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "L",
        "scopeName": "source.L",
        "path": "./syntaxes/l.tmLanguage.json"
      }
    ]
  }
}
