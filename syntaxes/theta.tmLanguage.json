{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Theta",
  "scopeName": "source.theta",
  "fileTypes": ["th"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#u-characters" },
    { "include": "#u-strings" },
    { "include": "#function-definition" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#enum-definition" },
    { "include": "#enum-access" },
    { "include": "#symbols" },
    { "include": "#column-symbols" },
    { "include": "#timestamps" },
    { "include": "#dates" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#attributes" },
    { "include": "#column-ref" },
    { "include": "#assignment" },
    { "include": "#function-call" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.theta",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.theta" }
          }
        },
        {
          "name": "comment.line.double-slash.theta",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.theta",
      "begin": "(?<!U)\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.theta",
          "match": "\\\\."
        }
      ]
    },
    "u-strings": {
      "name": "string.quoted.double.unicode.theta",
      "begin": "U\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.theta",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.theta",
      "match": "(?<!U)'(?:[^'\\\\]|\\\\.)'"
    },
    "u-characters": {
      "name": "string.quoted.single.unicode.theta",
      "match": "U'(?:[^'\\\\]|\\\\.)*'"
    },
    "function-definition": {
      "comment": "Matches: fn (x, y) { or async fn (x) {",
      "begin": "\\b(async\\s+)?(fn)\\s*\\(",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "keyword.other.theta" },
        "2": { "name": "keyword.other.theta" }
      },
      "patterns": [
        {
          "name": "variable.parameter.theta",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "punctuation.separator.parameter.theta",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.theta",
          "match": "\\b(if|elif|else|return|in|within|while)\\b"
        },
        {
          "name": "keyword.other.theta",
          "match": "\\b(fn|async|extern|enum)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.theta",
      "match": "\\b(ascend|average|average_unchecked|await|count|connect|descend|deserialize|graph|iascend|idesend|import|key|max|min|negate|random|random_secure|record|serialize|sleep|standard_deviation|standard_deviation_unchecked|sum|sum_unchecked|type|value|insert|insert!|map|range|table|insert_graph_node|insert_graph_edge|save|load|replay|delete|delete!|search|select|update|update!)(?=\\[)"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.theta",
          "match": "\\b(inf|__NaN__)\\b"
        },
        {
          "name": "constant.language.none.theta",
          "match": "::"
        },
        {
          "name": "constant.language.bool.theta",
          "match": "\\b[01]+b\\b"
        }
      ]
    },
    "enum-definition": {
      "name": "meta.enum.definition.theta",
      "match": "enum\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*<-",
      "captures": {
        "1": { "name": "entity.name.type.enum.theta" }
      }
    },
    "enum-access": {
      "name": "meta.enum.access.theta",
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)::(`[a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.enum.theta" },
        "2": { "name": "variable.other.enummember.theta" }
      }
    },
    "symbols": {
      "name": "constant.other.symbol.theta",
      "match": "`[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "column-symbols": {
      "name": "constant.other.column-symbol.theta",
      "match": "$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "timestamps": {
      "name": "constant.other.timestamp.theta",
      "match": "\\d{4}\\.\\d{2}\\.\\d{2}_\\d{2}:\\d{2}:\\d{2}\\.\\d+"
    },
    "dates": {
      "name": "constant.other.date.theta",
      "match": "\\d{4}\\.\\d{2}\\.\\d{2}(?!_)"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.theta",
          "match": "0x[0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.integer.theta",
          "match": "-?\\d+i\\b"
        },
        {
          "name": "constant.numeric.long.theta",
          "match": "-?\\d+l\\b"
        },
        {
          "name": "constant.numeric.float.theta",
          "match": "-?\\d+\\.\\d+"
        },
        {
          "name": "constant.numeric.long.plain.theta",
          "match": "(?<![`'\".a-zA-Z_])-?\\d+(?![ibx.a-zA-Z_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.theta",
          "match": "<<=|<-|<~"
        },
        {
          "name": "keyword.operator.comparison.theta",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.theta",
          "match": "&&|\\|\\||&\\?"
        },
        {
          "name": "keyword.operator.arithmetic.theta",
          "match": "[+\\-*%#,]"
        },
        {
          "name": "keyword.operator.expansion.theta",
          "match": "[+\\-*%#,=<>!&|]{1,3}[/\\\\|]"
        },
        {
          "name": "keyword.operator.not.theta",
          "match": "(?<![=!])!(?!=)"
        }
      ]
    },
    "attributes": {
      "name": "storage.modifier.attribute.theta",
      "match": "\\b([uadp])~"
    },
    "column-ref": {
      "name": "variable.other.column.theta",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "assignment": {
      "name": "meta.assignment.theta",
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*<-",
      "captures": {
        "1": { "name": "variable.other.theta" }
      }
    },
    "function-call": {
      "name": "meta.function-call.theta",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_!]*)(?=\\[)",
      "captures": {
        "1": { "name": "entity.name.function.theta" }
      }
    }
  }
}
